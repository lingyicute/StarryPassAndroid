    <!-- Notice & How It Works -->
    <string name="security_notice">StarryPass v2.1 derives passwords locally via RFC 9106 Argon2id + RFC 5869 HKDF with zero network permissions. Remember your master password — it can never be recovered if forgotten.</string>
    <string name="how_title">How It Works</string>
    <string name="how_step1_title">Memorize One Master Passphrase</string>
    <string name="how_step1_desc">Pick one strong phrase only you know. Avoid public personal info such as birthdays or initials.</string>
    <string name="how_step2_title">Assign a Code per Site</string>
    <string name="how_step2_desc">Distinguish accounts with a short site code like github, google, or cmb-card (case-sensitive).</string>
    <string name="how_step3_title">Derive Deterministically Anywhere</string>
    <string name="how_step3_desc">The same master + code + policy produces the exact same byte-for-byte password as StarryPass Web v2/v2.1. Increment rotation counter by +1 if any site leaks.</string>

